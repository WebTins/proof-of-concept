{% render 'partials/head.liquid' %}

<main class="home">
    <section class="nav-bar">
        <a href="/">
            <img src="assets/logo.png" width="250" alt="Pokemon" style="view-transition-name: logo;">
        </a>
        <h1>All Pokémon</h1>
        <div class="nav">
            <input type="text" id="search" placeholder="Search">
            <a href="/" class="home{% if page == "home" %} active {% endif %}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" id="Pokeball--Streamline-Tabler" height="24" width="24">
                    <desc>Pokeball Streamline Icon: https://streamlinehq.com</desc>
                    <path d="M3 12a9 9 0 1 0 18 0 9 9 0 1 0 -18 0" stroke-width="2"></path>
                    <path d="M9 12a3 3 0 1 0 6 0 3 3 0 1 0 -6 0" stroke-width="2"></path>
                    <path d="M3 12h6" stroke-width="2"></path><path d="M15 12h6" stroke-width="2"></path>
                </svg>
                All Pokémon
            </a>
            <a class="favorite-link" href="/favorites">
                <svg version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 122.88 107.41" height="20" width="20" stroke="currentColor" style="enable-background:new 0 0 122.88 107.41" xml:space="preserve">
                    <style type="text/css">.st0{fill-rule:evenodd;clip-rule:evenodd;}</style>
                    <g><path class="st0" d="M60.83,17.19C68.84,8.84,74.45,1.62,86.79,0.21c23.17-2.66,44.48,21.06,32.78,44.41 c-3.33,6.65-10.11,14.56-17.61,22.32c-8.23,8.52-17.34,16.87-23.72,23.2l-17.4,17.26L46.46,93.56C29.16,76.9,0.95,55.93,0.02,29.95 C-0.63,11.75,13.73,0.09,30.25,0.3C45.01,0.5,51.22,7.84,60.83,17.19L60.83,17.19L60.83,17.19z"/></g>
                </svg>
                Favorites
            </a>
        </div>  
    </section>

<div class="wrapper">
    <div class="pokemon-card">
        {% for pokemon in pokemon %}
            <a href="/pokemon/{{ pokemon.id }}" data-name="{{ pokemon.name }}">
                <article data-type="{{ pokemon.type }}" class="card type-{{ pokemon.types[0] }}">
                    <h2 style="view-transition-name: title-{{ pokemon.name }};">{{ pokemon.name | capitalize}}</h2>
                        <img src="{{ pokemon.image }}" alt="{{ pokemon.name }}" width="100" style="view-transition-name:{{ pokemon.name }};">
                </article>
            </a>
        {% endfor %}
    </div>
</div>
</main>
{% render 'partials/foot.liquid' %}