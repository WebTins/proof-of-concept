{% render 'partials/head.liquid' %}

<main class="main-detail type-{{ pokemon.types[0] }}">
    <a href="/" class="back-link">← Back</a>

    <div class="pokemon-detail">
        <section class="pokemon-info">
            <a href="/">
            <img src="/assets/logo.png" width="200" alt="Pokemon" style="view-transition-name: logo;">
            </a>
            <p class="pokemon-id">#{{ pokemon.id | prepend: "000" | slice: -4, 4 }}</p>
            <h1 style="view-transition-name: title-{{ pokemon.name }};">{{ pokemon.name | capitalize }}</h1>
            <img src="{{ pokemon.image }}" alt="{{ pokemon.name }}" style="view-transition-name:{{ pokemon.name }};" width="200" class="pokemon-image">
            {% if isLiked %}
                <form action="/pokemon/{{ pokemon.id }}/unlike" method="POST">
                    <input type="hidden" name="user_id" value="6">
                    <button class="submit unlike" type="submit">💔 Unfavourite</button>
                </form>
            {% else %}
                <form action="/pokemon/{{ pokemon.id }}/like" method="POST">
                    <input type="hidden" name="user_id" value="6">
                    <button class="submit like" type="submit">❤ Favourite</button>
                </form>
            {% endif %}
        </section>

        <!--MARK: TABS-->
        <div class="pokemon-tabs">
            <nav>
                <a href="#about">About</a>
                <a href="#stats">Stats</a>
                <a href="#evolutions">Evolutions</a>
            </nav>

            <!--MARK: CAROUSEL-->
            <div class="tab-carousel">
                <!--MARK: ABOUT-->
                <div id="about">
                    <table>
                        <tr><th>Name</th><td>{{ pokemon.name | capitalize }}</td></tr>
                        <tr><th>ID</th><td>#{{ pokemon.id | prepend: "000" | slice: -4, 4 }}</td></tr>
                        <tr><th>Base XP</th><td>{{ pokemon.baseXP }}</td></tr>
                        <tr><th>Weight</th><td>{{ pokemon.weight | divided_by: 10.0 }} kg</td></tr>
                        <tr><th>Height</th><td>{{ pokemon.height | divided_by: 10.0 }} m</td></tr>
                        <tr>
                            <th>Type</th>
                            <td>
                                {% for type in pokemon.types %}
                                    <span class="type-badge type-{{ type }}">{{ type | capitalize }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                        <tr>
                            <th>Abilities</th>
                            <td>
                                {% for ability in pokemon.abilities %}
                                    {{ ability | capitalize }}{% unless forloop.last %}, {% endunless %}
                                {% endfor %}
                            </td>
                        </tr>
                    </table>
                </div>

                <!--MARK: STATS-->
                <div id="stats">
                    {% for stat in pokemon.stats %}
                        <div class="stat-row">
                            <span class="stat-name">{{ stat.name | capitalize }}</span>
                            <span class="stat-value">{{ stat.value }}</span>
                            <meter min="0" max="255" value="{{ stat.value }}"></meter>
                        </div>
                    {% endfor %}
                </div>

                <!--MARK: EVOLUTIONS-->
                <div id="evolutions">
                    {% for evo in pokemon.evolutions %}
                        <a href="/pokemon/{{ evo.id }}" class="evolution-card">
                        {% comment %} 
                            De if en else statement zijn voor de view transition. Als dezelfde huidige pokemon geselecteerd wordt
                            dan komt er geen view transition. En daarom krijgt de huidige image ook geen view transition mee.
                            Als de evolutie pokemon wordt geselecteerd die niet hetzelfde is, dan komt er wel een view transition
                            dat wordt dus meegegeven in de else statement.
                        {% endcomment %}
                            {% if evo.name == pokemon.name %}
                            <img src="{{ evo.image }}" alt="{{ evo.name }}" width="60">
                            {% else %}
                            <img src="{{ evo.image }}" alt="{{ evo.name }}" width="60" style="view-transition-name: {{ evo.name }};">
                            {% endif %}
                            <div class="evolution-info">
                                <span class="evo-id">#{{ evo.id | prepend: "000" | slice: -4, 4 }}</span>
                                <p>{{ evo.name | capitalize }}</p>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</main>

{% render 'partials/foot.liquid' %}